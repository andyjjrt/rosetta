# Bot config
BOT_TOKEN=xxx
BOT_CLIENT_ID=xxx

# LLM config
LLM_BASE_URL=xxx
LLM_API_KEY=xxx
LLM_DEFAULT_MODEL=xxx

# Langfuse config (optional; tracing is disabled unless both keys are set)
# LANGFUSE_PUBLIC_KEY=pk-lf-xxx
# LANGFUSE_SECRET_KEY=sk-lf-xxx
# LANGFUSE_HOST=https://cloud.langfuse.com

# MCP config (optional; disabled by default)
# MCP_ALLOWED_HOSTS uses JSON list syntax, for example: ["127.0.0.1", "localhost"]
# MCP_ENABLED=true
# MCP_HOST=127.0.0.1
# MCP_PORT=8000
# MCP_PATH=/mcp
# MCP_BEARER_TOKEN=xxx... (at least 32 characters when enabled)
# MCP_ALLOWED_HOSTS=["127.0.0.1", "localhost"]

# Nanobot config (optional; disabled by default)
# Copy nanobot.config.example.json to an operator-owned path before enabling.
# COG_NANOBOT_DISABLE=false
# NANOBOT_CONFIG_PATH=.data/nanobot/config.json
# NANOBOT_POLICY_PATH=.data/nanobot/guild-policies.json
# NANOBOT_MAX_CONCURRENT_RUNS=3
# NANOBOT_WORKSPACE=.data/nanobot/workspace
# NANOBOT_ROSETTA_MCP_URL=http://127.0.0.1:8000/mcp/

# Lavalink config
# Discovery mode: "local" for local development, "k8s" for Kubernetes auto-discovery
LAVALINK_DISCOVERY_MODE=local

# Local development settings
LAVALINK_HOST=127.0.0.1
LAVALINK_PORT=2333
LAVALINK_PASSWORD=youshallnotpass
# Number of sequential local nodes starting at LAVALINK_PORT (dev default: 2; production Compose sets 1)
LAVALINK_LOCAL_NODE_COUNT=2

# Kubernetes discovery settings (used when LAVALINK_DISCOVERY_MODE=k8s)
# LAVALINK_K8S_NAMESPACE=default
# LAVALINK_K8S_SERVICE_NAME=lavalink
# LAVALINK_K8S_SERVICE_PORT=2333

# Sharding (optional)
# SHARD_ID=rosetta-0
# TOTAL_SHARDS=1

# Note: Emojis are automatically fetched from the bot's application emojis.
# Upload emojis with these names to your Discord application:
# success, error, youtube, progress_start, progress, progress_mix,
# progress_fill, progress_end, progress_fill_end, progress_start_0
